  //
  // This tasks.json is common for all applications, located in appdev/apps.
  "version": "2.0.0",
  "tasks": [
        {
            "label": "Configure app from active configure preset",
            "type": "shell",
            "detail": "Application configure task for currently active preset",
            "command": "cmake",
            "group": "build",
            "args": [
                ".", "--preset", "${command:cmake.activeBuildPresetName}"
            ],
            "options": {
                "cwd": "${command:cmake.activeFolderPath}"
            },
            "hide": true,
            "problemMatcher": []
        },
        {
            "label": "Build app from active build preset",
            "type": "shell",
            "dependsOn": "Configure app from active configure preset",
            "detail": "Application build task for currently active preset",
            "command": "cmake",
            "group": "build",
            "args": [
                "--build", "--preset", "${command:cmake.activeBuildPresetName}"
            ],
            "options": {
                "cwd": "${command:cmake.activeFolderPath}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Deploy app from active build preset",
            "type": "shell",
            "dependsOn": "Build app from active build preset",
            "command": "/workspace/appdev/scripts/target.sh -c deploy -a ${command:cmake.activeFolderPath} -p ${command:cmake.activeBuildPresetName}",
            "problemMatcher": []
        },
        {
            "label": "Run app from active build preset",
            "type": "shell",
            "dependsOn": "Build app from active build preset",
            "command": "/workspace/appdev/scripts/target.sh -c run -a ${command:cmake.activeFolderPath} -p ${command:cmake.activeBuildPresetName} -b ${command:cmake.launchTargetPath}",
            "problemMatcher": []
        },
        {
            "label": "Start gdb on target",
            "detail": "Start gdbserver on remote deployment target",
            "type": "shell",
            "hide": true,
            "dependsOn": "Build app from active build preset",
            "command": "/workspace/appdev/scripts/target.sh -c start_debug -a ${command:cmake.activeFolderPath} -p ${command:cmake.activeBuildPresetName}",
            "problemMatcher": []
        },
        {
            "label": "Attach gdb on target",
            "detail": "Attach gdbserver on remote deployment target to ${command:cmake.launchTargetPath}",
            "type": "shell",
            "hide": true,
            "command": "/workspace/appdev/scripts/target.sh -c attach_debug -a ${command:cmake.activeFolderPath} -p ${command:cmake.activeBuildPresetName} -b ${command:cmake.launchTargetPath}",
            "problemMatcher": []
        },
        {
            "label": "Stop gdb on target",
            "detail": "Stop gdbserver on remote deployment target",
            "type": "shell",
            "hide": true,
            "command": "/workspace/appdev/scripts/target.sh -c stop_debug -a ${command:cmake.activeFolderPath} -p ${command:cmake.activeBuildPresetName}",
            "problemMatcher": []
        }
    ]
}
