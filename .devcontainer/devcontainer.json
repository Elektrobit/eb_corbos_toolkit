// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
    "name": "EB corbos Toolkit",
    // the container is updated by CI directly "in place" with the same tag,
    // so we always need to pull the latest image manually before starting the container
    "image": "ghcr.io/elektrobit/eb-corbos-toolkit-devcontainer-amd64:v30",
    // set the tag to local if you are using a locally built image
    // "image": "artifactory.elektrobit.com/eb_corbos_linux-releases-docker/eb-corbos-toolkit/devcontainer-amd64:local",
    "initializeCommand": ".devcontainer/lifecycle/run.sh --profile dev initializeCommand",
    // The lifecycle scripts are looked up and executed by the dispatcher, see .devcontainer/lifecycle/README.md
    "postStartCommand": {
        "Run postStartCommand lifecycle script": ".devcontainer/lifecycle/run.sh --profile dev postStartCommand --check",
        "Run optional user postStartCommand": "if [ -f .devcontainer/post_start_hook.sh ]; then bash .devcontainer/post_start_hook.sh; fi"
    },
    "postCreateCommand": {
        "Run postCreateCommand lifecycle script": ".devcontainer/lifecycle/run.sh --profile dev postCreateCommand",
        "Run optional user postCreateCommand": "if [ -f .devcontainer/post_create_hook.sh ]; then bash .devcontainer/post_create_hook.sh; fi"
    },
    "containerEnv": {
        "GITCONFIG_FILE": "/workspace/.devcontainer/kas.gitconfig",
        // Unfortunately, BitBake requires this in any case - even if the .netrc file is located in the default location.
        "NETRC_FILE": "/home/developer/.netrc"
    },
    "containerUser": "developer",
    "mounts": [
        {
            "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.ssh",
            "target": "/home/developer/.ssh",
            "type": "bind"
        },
        {
            "source": "${localWorkspaceFolder}/.devcontainer/credentials.netrc",
            "target": "/home/developer/.netrc",
            "type": "bind"
        },
        {
            "source": "/dev",
            "target": "/dev",
            "type": "bind"
        },
        {
            "source": "eb-corbos-toolkit-bash-history-${devcontainerId}",
            "target": "/commandhistory",
            "type": "volume"
        }
    ],
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "privileged": true,
    "runArgs": [
        "--hostname",
        "eb-corbos-toolkit",
        "--env-file",
        "${localWorkspaceFolder}/.devcontainer/timezone.env"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python@2026.5.2026032701",
                "ms-vscode.cpptools-extension-pack@1.3.1"
            ],
            "settings": {
                "cmake.configureOnOpen": false,
                "taskExplorer.showHiddenWsTasks": false
            }
        }
    }
}
