From 297b305e8ec2727878feff01e6b73b77dc73c5c1 Mon Sep 17 00:00:00 2001
From: Sergei Koziakov <Sergei.Koziakov@elektrobit.com>
Date: Fri, 27 Mar 2026 13:05:49 +0000
Subject: [PATCH 2/2] SBOM: update debsbom remote url to release

Update the remote url of debsbom so that it works with Artifactory
mirroring.

This patch should not be submitted to upstream.
---
 .../python3-debsbom/python3-debsbom_0.7.1.bb              | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/meta/recipes-support/python3-debsbom/python3-debsbom_0.7.1.bb b/meta/recipes-support/python3-debsbom/python3-debsbom_0.7.1.bb
index ed50b2ef..e14b82f8 100644
--- a/meta/recipes-support/python3-debsbom/python3-debsbom_0.7.1.bb
+++ b/meta/recipes-support/python3-debsbom/python3-debsbom_0.7.1.bb
@@ -7,13 +7,11 @@ inherit ebclfsa_dpkg_python
 
 FILESEXTRAPATHS:prepend := "${THISDIR}/files:"
 
-S = "${WORKDIR}/git"
-
 DEPENDS:append:bookworm = " python3-packageurl"
 DEPENDS:append:trixie = " python3-packageurl"
 DEPENDS:append:noble = " python3-packageurl"
 
-S = "${WORKDIR}/git"
+S = "${WORKDIR}/debsbom-${PV}"
 
 MAINTAINER = "Christoph Steiger <christoph.steiger@siemens.com>"
 DPKG_ARCH = "all"
@@ -32,12 +30,10 @@ DEBIAN_DEPENDS = "python3-apt, \${python3:Depends}, \${misc:Depends}"
 
 DESCRIPTION = "debsbom generates SBOMs for Debian based distributions."
 
-SRC_URI = "git://github.com/siemens/debsbom.git;protocol=https;branch=main; \
+SRC_URI = "https://github.com/siemens/debsbom/archive/refs/tags/v${PV}.tar.gz \
            file://rules \
            file://0001-Use-old-license-description-in-pyproject.toml.patch \
            "
-SRCREV = "c80cadb28b15add6f2c0a03c0d5cbf3a252c5f15"
-
 do_prepare_build[cleandirs] += "${S}/debian"
 do_prepare_build() {
     deb_debianize
-- 
