         )
 
 
+class CargoPackage(SourcePackage):
+    """Cargo crate represented by its lockfile-resolved name and version."""
+
+    def purl(self, vendor="debian") -> PackageURL:
+        return PackageURL(type="cargo", name=self.name, version=str(self.version))
+
+
