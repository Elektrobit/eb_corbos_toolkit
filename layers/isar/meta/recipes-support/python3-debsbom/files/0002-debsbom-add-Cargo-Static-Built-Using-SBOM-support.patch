 src/debsbom/generate/cdx.py  | 12 ++++++--
 src/debsbom/generate/spdx.py | 25 ++++++++++++++--
 src/debsbom/sbom.py          | 13 +++++++--
 tests/test_dpkg.py           | 25 +++++++++++++++-
 tests/test_generation.py     | 56 +++++++++++++++++++++++++++++++++++-
 6 files changed, 149 insertions(+), 10 deletions(-)

