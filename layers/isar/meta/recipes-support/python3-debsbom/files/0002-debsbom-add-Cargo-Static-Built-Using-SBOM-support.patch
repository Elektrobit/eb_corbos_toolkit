+        for dep in pkg.static_built_using:
+            if not dep.version or dep.version[0] != "=":
+                logger.warning(f"Ignoring unversioned Static-Built-Using entry: {dep.name}")
+                continue
+            logger.debug(f"Found built-using Cargo crate: '{dep.name}@{dep.version[1]}'")
+            yield CargoPackage(dep.name, dep.version[1])
         if add_pkg:
             yield pkg
 
