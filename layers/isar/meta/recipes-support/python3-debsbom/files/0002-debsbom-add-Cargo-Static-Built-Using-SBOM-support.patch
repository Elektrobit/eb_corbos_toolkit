+def test_static_built_using_cargo_generation(tmpdir):
+    pytest.importorskip("spdx_tools")
+    pytest.importorskip("cyclonedx")
+
+    kura = BinaryPackage(
+        name="kura",
+        version="0.1.0",
+        architecture="arm64",
+        static_built_using=[
+            Dependency("serde", version=("=", Version("1.0.228"))),
+            Dependency("tokio", version=("=", Version("1.50.0"))),
+        ],
+    )
+    cargo_packages = list(Package.referenced_src_packages([kura]))
+    assert all(isinstance(package, CargoPackage) for package in cargo_packages)
+    packages = {kura, *cargo_packages}
+
+    spdx_file = Path(tmpdir) / "cargo.spdx.json"
+    spdx_document = spdx_bom(packages, distro_name="pytest-distro", distro_arch="arm64")
+    BomWriter.create(SBOMType.SPDX).write_to_file(spdx_document, spdx_file, validate=True)
+    spdx_json = json.loads(spdx_file.read_text())
+    serde_package = next(package for package in spdx_json["packages"] if package["name"] == "serde")
+    assert any(
+        reference["referenceLocator"] == "pkg:cargo/serde@1.0.228"
+        for reference in serde_package["externalRefs"]
+    )
+    assert any(
+        relation["spdxElementId"] == "SPDXRef-kura-arm64"
+        and relation["relatedSpdxElement"] == "SPDXRef-cargo-serde-1.0.228-srcpkg"
+        and relation["relationshipType"] == "GENERATED_FROM"
+        for relation in spdx_json["relationships"]
+    )
+
+    cdx_file = Path(tmpdir) / "cargo.cdx.json"
+    cdx_bom = cyclonedx_bom(packages, distro_name="pytest-distro", distro_arch="arm64")
+    BomWriter.create(SBOMType.CycloneDX).write_to_file(cdx_bom, cdx_file, validate=True)
+    cdx_json = json.loads(cdx_file.read_text())
+    assert any(
+        component["purl"] == "pkg:cargo/serde@1.0.228"
+        and component.get("group") is None
+        for component in cdx_json["components"]
+    )
+    kura_dependency = next(
+        dependency
+        for dependency in cdx_json["dependencies"]
+        if dependency["ref"] == "pkg:deb/debian/kura@0.1.0?arch=arm64"
+    )
+    assert "pkg:cargo/serde@1.0.228" in kura_dependency["dependsOn"]
+    assert "pkg:cargo/tokio@1.50.0" in kura_dependency["dependsOn"]
+
+
