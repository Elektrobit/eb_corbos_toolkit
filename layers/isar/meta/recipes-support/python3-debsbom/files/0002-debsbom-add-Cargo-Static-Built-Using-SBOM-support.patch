+def test_parse_static_built_using_cargo_crates():
+    record = next(
+        Packages.iter_paragraphs(
+            io.BytesIO(
+                b"Package: kura\nVersion: 0.1.0\nArchitecture: arm64\n"
+                b"Static-Built-Using: serde (= 1.0.228), tokio (= 1.50.0)\n\n"
+            ),
+            use_apt_pkg=False,
+        )
+    )
+    package = BinaryPackage.from_deb822(record)
+    assert package.static_built_using == [
+        Dependency("serde", version=("=", Version("1.0.228"))),
+        Dependency("tokio", version=("=", Version("1.50.0"))),
+    ]
+    cargo_packages = list(Package.referenced_src_packages([package]))
+    assert [p.purl().to_string() for p in cargo_packages if isinstance(p, CargoPackage)] == [
+        "pkg:cargo/serde@1.0.228",
+        "pkg:cargo/tokio@1.50.0",
+    ]
+
