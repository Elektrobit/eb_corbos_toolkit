diff --git a/src/debsbom/sbom.py b/src/debsbom/sbom.py
index bda1f5b..b6694a2 100644
--- a/src/debsbom/sbom.py
+++ b/src/debsbom/sbom.py
@@ -7,7 +7,7 @@ from dataclasses import dataclass
 from enum import Enum
 import re
 
-from .dpkg.package import BinaryPackage, Dependency, Package
+from .dpkg.package import BinaryPackage, CargoPackage, Dependency, Package
 
 CDX_REF_PREFIX = "CDXRef-"
 CDX_PACKAGE_EXTREF_TYPE_WEBSITE = "website"
@@ -155,7 +155,9 @@ class Reference:
         Return a reference to a package in the list of all packages.
         This representation must match the one returned by ``make_from_dep``.
         """
-        if pkg.is_source():
+        if isinstance(pkg, CargoPackage):
+            return Reference(target=f"cargo-{pkg.name}-{pkg.version}", is_source=True)
+        elif pkg.is_source():
             return Reference(target=f"{pkg.name}-{pkg.version}", is_source=True)
         elif pkg.is_binary():
             return Reference(target=f"{pkg.name}-{pkg.architecture}", is_source=False)
@@ -174,6 +176,13 @@ class Reference:
             to_arch = to_arch or dep.arch
             return Reference(target=f"{dep.name}-{to_arch}", is_source=False)
 
+    @staticmethod
+    def make_from_cargo_dep(dep: Dependency) -> "Reference":
+        """Return a reference to an exactly versioned Cargo crate."""
+        if not dep.version or dep.version[0] != "=":
+            raise ValueError(f"Cargo dependency {dep.name} must have an exact version")
+        return Reference(target=f"cargo-{dep.name}-{dep.version[1]}", is_source=True)
+
 
 class BomSpecific:
     """Mixin to denote that a class processes bom type specific data"""
