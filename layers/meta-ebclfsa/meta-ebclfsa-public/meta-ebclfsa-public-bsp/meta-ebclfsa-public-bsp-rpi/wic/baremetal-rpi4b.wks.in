bootloader --ptable msdos

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 50
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4096 --size 1G
part --size 1G --ondisk mmcblk0 --fstype=ext4 --label data --align 4096
