bootloader --ptable msdos

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 50
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4096 --size ${EBCLFSA_FASTDEV_ROOTFS_PARTITION_SIZE_MB}M
part --size ${EBCLFSA_FASTDEV_DATA_PARTITION_SIZE_MB}M --ondisk mmcblk0 --fstype=ext4 --label data --align 4096
