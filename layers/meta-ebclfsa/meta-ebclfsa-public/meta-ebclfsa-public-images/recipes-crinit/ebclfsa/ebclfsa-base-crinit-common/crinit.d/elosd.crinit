# loads the event log scanner (elos)
NAME = elosd

# elosd listens on 127.0.0.1, which netifd assigns to lo asynchronously.
COMMAND = /bin/mkdir -p /run/elos
          /bin/sh -c "while ! ip -4 address show dev lo up | grep -q 'inet 127.0.0.1/'; do sleep 1; done; exec /usr/bin/elosd"

DEPENDS = @provided:fstab @provided:tmpdir @provided:machine-id @provided:network

PROVIDES = elos:spawn syslog:spawn

RESPAWN = YES
RESPAWN_RETRIES = 3

USER = elos
GROUP = elos
CAPABILITY_SET = CAP_SYSLOG CAP_DAC_OVERRIDE
