From: Elektrobit <info@elektrobit.com>
Subject: [PATCH] Add custom version tag

Append "-custom" to the version string so the rebuilt package is
identifiable via "iptables --version".

diff --git a/configure.ac b/configure.ac
index 1111111..2222222 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1,5 +1,5 @@

-AC_INIT([iptables], [1.8.11])
+AC_INIT([iptables], [1.8.11-custom])

 # See libtool.info "Libtool's versioning system"
 libxtables_vcurrent=19
