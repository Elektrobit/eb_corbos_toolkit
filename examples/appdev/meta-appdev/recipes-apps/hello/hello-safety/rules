#!/usr/bin/make -f

# Copyright 2025 Elektrobit. All rights reserved.

# Enable hardening flags
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# Workaround for dh_dwz failing to parse the default debug symbol format from clang-20
CFLAGS += -gdwarf-4

ifeq ($(DEB_HOST_ARCH),arm64)
# Use toolchain file for HI arm64 musl-clang builds:
CMAKE_ARGS += -DCMAKE_TOOLCHAIN_FILE=/usr/share/cmake/ebclfsa/toolchain/compositions/toolchain-clang-hi-arm64.cmake -DPROJECT_PACKAGING_BUILD=ON
export TOOLCHAIN_BASE=/usr/share/cmake/ebclfsa/toolchain/
else
# For other architectures, just use plain clang as there is no lisa-libc for anything but arm64
CC := clang-20
endif

override_dh_auto_configure:
	dh_auto_configure -- $(CMAKE_ARGS)

# Run the lisa-elf-enabler after all stripping operations are carried out
override_dh_strip:
	dh_strip

	for bin in $(CURDIR)/debian/hello-safety/usr/bin/*; do \
		echo "Patching $${bin} for HI support"; \
		lisa-elf-enabler $${bin}; \
	done
